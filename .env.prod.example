# ============================================================
# Clarity Retail Hub — Production Environment (.env.prod)
# ============================================================

# Django Core Security
SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-clarity-hub
DEBUG=False
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://*.yourdomain.com,https://*.yourdomain.com,http://your-ec2-ip

# Port Exposed on AWS Host (default 80 for direct HTTP traffic)
HOST_PORT=80

# PostgreSQL Production Database Credentials
DB_NAME=clarity_retail_hub_prod
DB_USER=hub_prod_user
DB_PASSWORD=generate-a-strong-database-password-here
DB_HOST=db
DB_PORT=5432

# Multi-Tenancy Base Domain (e.g. clarityhub.co.za)
TENANT_BASE_DOMAIN=localhost

# Docker Hub Registry & Image Tag
DOCKER_REGISTRY=yourdockerhubusername
TAG=latest

# Performance & SSL Security
GUNICORN_WORKERS=0
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_SECURE=False

# Sentry Error Monitoring (Optional)
SENTRY_DSN=
